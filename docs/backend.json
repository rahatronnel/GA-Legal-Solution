
{
  "entities": {
    "OrganizationSettings": {
      "title": "Organization Settings",
      "type": "object",
      "description": "A singleton entity to store application-wide organization settings.",
      "properties": {
        "name": { "type": "string", "description": "The name of the organization." },
        "slogan": { "type": "string", "description": "The organization's slogan." },
        "address": { "type": "string", "description": "The physical address of the organization." },
        "contactNumber": { "type": "string", "description": "Primary contact phone number." },
        "telephone": { "type": "string", "description": "Secondary telephone number." },
        "email": { "type": "string", "format": "email", "description": "Contact email address." },
        "fax": { "type": "string", "description": "Fax number." },
        "registrationNumber": { "type": "string", "description": "Official registration number." },
        "logo": { "type": "string", "description": "Data URL of the organization's logo." },
        "favicon": { "type": "string", "description": "Data URL of the favicon." },
        "notificationReminderHours": { "type": "number", "description": "Hours after which a pending task triggers a reminder/escalation.", "default": 24 },
        "moduleVisibility": {
          "type": "object",
          "properties": {
            "showProcurementManagement": { "type": "boolean" },
            "showCoreModules": { "type": "boolean" },
            "showLikeExam": { "type": "boolean" },
            "enableNotifications": { "type": "boolean" }
          }
        },
        "approvalFlow": {
            "type": "object",
            "description": "Defines the bill approval workflow.",
            "properties": {
                "effectiveDate": { "type": "string", "format": "date" },
                "steps": {
                    "type": "array",
                    "description": "An ordered list of approval steps.",
                    "items": {
                        "object": {
                            "properties": {
                                "stepName": { "type": "string" },
                                "approverId": { "type": "string" },
                                "statusName": { "type": "string" }
                            },
                            "required": ["stepName", "approverId", "statusName"]
                        }
                    }
                }
            }
        },
        "procurementSettings": {
          "type": "object",
          "description": "Settings specific to the procurement module approvals.",
          "properties": {
            "departmentHeads": {
              "type": "array",
              "description": "An array mapping sections to their head and technical advisor employees.",
              "items": {
                "type": "object",
                "properties": {
                  "sectionId": { "type": "string" },
                  "headId": { "type": "string" },
                  "technicalAdvisorId": { "type": "string" }
                },
                "required": ["sectionId", "headId", "technicalAdvisorId"]
              }
            },
            "managingDirectorId": { "type": "string", "description": "Employee ID of the Managing Director." },
            "factoryDirectorId": { "type": "string", "description": "Employee ID of the Factory Director." },
            "manufacturingDeptManagerId": { "type": "string", "description": "Employee ID of the Manufacturing Dept Manager." },
            "specializedDeptManagerId": { "type": "string", "description": "Employee ID of the Specialized Dept. Manager." },
            "specializedDeptTaId": { "type": "string", "description": "Employee ID of the Specialized Dept. Technical Advisor." },
            "generalPurchaseOfficerId": { "type": "string", "description": "Employee ID of the General Purchase Officer." },
            "gpConcernOfficerIds": {
              "type": "array",
              "description": "A list of employee IDs who are eligible GP Concern Officers.",
              "items": { "type": "string" }
            },
            "csApprovalRoles": {
              "type": "object",
              "description": "Defines the roles for the Comparative Statement (CS) approval workflow.",
              "properties": {
                "purchaseManagerId": { "type": "string", "description": "Employee ID of the Purchase Manager." },
                "purchaseDeptTaId": { "type": "string", "description": "Employee ID of the Purchase Department Technical Advisor." },
                "viceFactoryManagerId": { "type": "string", "description": "Employee ID of the Vice Factory Manager." },
                "accountsManagerId": { "type": "string", "description": "Employee ID of the Accounts Manager." },
                "gmSalesDeptId": { "type": "string", "description": "Employee ID of the GM of Sales Department." },
                "gmAdministrationId": { "type": "string", "description": "Employee ID of the GM of Administration." },
                "approvalAmountBasis": {
                  "type": "string",
                  "enum": ["Minimum", "Average", "Maximum"],
                  "description": "The basis for determining the amount used for the CS approval workflow."
                }
              }
            },
            "poSettings": {
              "type": "object",
              "description": "Settings for Purchase Orders.",
              "properties": {
                "mandatoryTerms": { "type": "string", "description": "Default mandatory terms for a PO." },
                "otherTerms": { "type": "string", "description": "Default other terms for a PO." }
              }
            }
          }
        }
      },
      "required": ["name", "email"]
    },
    "AcknowledgedTask": {
      "title": "Acknowledged Task",
      "type": "object",
      "description": "Represents a user acknowledging a task notification.",
      "properties": {
        "userId": { "type": "string" },
        "taskId": { "type": "string" },
        "acknowledgedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "taskId"]
    },
    "Department": {
      "title": "Department",
      "type": "object",
      "description": "Represents an organizational department.",
      "properties": {
        "name": { "type": "string", "description": "The name of the department." },
        "code": { "type": "string", "description": "The unique code for the department." }
      },
      "required": ["name", "code"]
    },
    "Section": {
      "title": "Section",
      "type": "object",
      "description": "Represents a department or section within the organization.",
      "properties": {
        "name": { "type": "string", "description": "The name of the section." },
        "sectionCode": { "type": "string", "description": "The unique code for the section." },
        "isManufacturingDept": { "type": "boolean", "description": "Indicates if this section is a manufacturing department." }
      },
      "required": ["name", "sectionCode"]
    },
    "Designation": {
      "title": "Designation",
      "type": "object",
      "description": "Represents a job title or designation for an employee.",
      "properties": {
        "name": { "type": "string", "description": "The name of the designation." },
        "designationCode": { "type": "string", "description": "The unique code for the designation." }
      },
      "required": ["name", "designationCode"]
    },
    "Employee": {
      "title": "Employee",
      "type": "object",
      "description": "Represents an employee in the organization.",
      "properties": {
        "userIdCode": { "type": "string" },
        "fullName": { "type": "string" },
        "mobileNumber": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["Admin", "Operator", "Driver", "Viewer"] },
        "status": { "type": "string", "enum": ["Active", "Inactive"] },
        "username": { "type": "string" },
        "departmentId": { "type": "string" },
        "sectionId": { "type": "string" },
        "designationId": { "type": "string" },
        "joiningDate": { "type": "string", "format": "date" },
        "address": { "type": "string" },
        "remarks": { "type": "string" },
        "profilePicture": { "type": "string", "description": "Data URL of the profile picture." },
        "signature": { "type": "string", "description": "Data URL of the employee's signature." },
        "documents": {
          "type": "object",
          "properties": {
            "nid": { "type": "string", "description": "Data URL of the NID document." },
            "other": { "type": "string", "description": "Data URL of the other document." }
          }
        },
        "defaultPassword": { "type": "string", "description": "Default password for the new user." }
      },
      "required": ["userIdCode", "fullName", "mobileNumber", "username", "role", "status", "email"]
    },
    "VehicleType": {
      "title": "Vehicle Type", "type": "object", "description": "Defines a type or category of a vehicle.",
      "properties": { "name": { "type": "string" }, "vehicleTypeCode": { "type": "string" } }, "required": ["name", "vehicleTypeCode"]
    },
    "VehicleBrand": {
      "title": "Vehicle Brand", "type": "object", "description": "Defines a vehicle brand.",
      "properties": { "name": { "type": "string" }, "code": { "type": "string" } }, "required": ["name", "code"]
    },
    "Location": {
      "title": "Location", "type": "object", "description": "Defines a geographic location.",
      "properties": { "name": { "type": "string" }, "locationCode": { "type": "string" } }, "required": ["name", "locationCode"]
    },
    "DeliveryPlace": {
      "title": "Delivery Place",
      "type": "object",
      "description": "Defines an office or delivery location for procurement.",
      "properties": {
        "name": { "type": "string", "description": "The name of the location." },
        "code": { "type": "string", "description": "The unique code for the location." },
        "address": { "type": "string", "description": "The physical address of the office." }
      },
      "required": ["name", "code", "address"]
    },
    "Route": {
      "title": "Route", "type": "object", "description": "Defines a route between two locations.",
      "properties": { "name": { "type": "string" }, "routeCode": { "type": "string" }, "startLocationId": { "type": "string" }, "endLocationId": { "type": "string" } }, "required": ["name", "routeCode", "startLocationId", "endLocationId"]
    },
    "TripPurpose": {
      "title": "Trip Purpose", "type": "object", "description": "Defines a purpose for a vehicle trip.",
      "properties": { "name": { "type": "string" } }, "required": ["name"]
    },
    "ExpenseType": {
      "title": "Expense Type", "type": "object", "description": "Defines a type of expense.",
      "properties": { "name": { "type": "string" }, "code": { "type": "string" } }, "required": ["name", "code"]
    },
    "MaintenanceType": {
      "title": "Maintenance Type", "type": "object", "description": "Defines a type of maintenance.",
      "properties": { "name": { "type": "string" }, "code": { "type": "string" } }, "required": ["name", "code"]
    },
    "MaintenanceExpenseType": {
      "title": "Maintenance Expense Type", "type": "object", "description": "Defines a type of expense for maintenance.",
      "properties": { "name": { "type": "string" }, "code": { "type": "string" } }, "required": ["name", "code"]
    },
    "Part": {
      "title": "Part", "type": "object", "description": "Defines a vehicle part.",
      "properties": { "name": { "type": "string" }, "code": { "type": "string" }, "brand": { "type": "string" }, "price": { "type": "number" } }, "required": ["name", "code"]
    },
    "ServiceCenter": {
      "title": "Service Center", "type": "object", "description": "Defines a service center or garage.",
      "properties": { "name": { "type": "string" }, "code": { "type": "string" }, "address": { "type": "string" }, "mobileNumber": { "type": "string" }, "ownerName": { "type": "string" } }, "required": ["name", "code"]
    },
    "AccidentType": {
      "title": "Accident Type", "type": "object", "description": "Defines a type of accident.",
      "properties": { "name": { "type": "string" }, "code": { "type": "string" } }, "required": ["name", "code"]
    },
    "SeverityLevel": {
      "title": "Severity Level", "type": "object", "description": "Defines a severity level for accidents.",
      "properties": { "name": { "type": "string" }, "code": { "type": "string" } }, "required": ["name", "code"]
    },
    "FaultStatus": {
      "title": "Fault Status", "type": "object", "description": "Defines the fault status of an accident.",
      "properties": { "name": { "type": "string" }, "code": { "type": "string" } }, "required": ["name", "code"]
    },
    "VendorCategory": {
      "title": "Vendor Category",
      "type": "object",
      "description": "Defines a category for a vendor or supplier.",
      "properties": {
        "name": { "type": "string", "description": "The name of the category." },
        "code": { "type": "string", "description": "The unique code for the category." }
      },
      "required": ["name", "code"]
    },
    "VendorNatureOfBusiness": {
      "title": "Vendor Nature of Business",
      "type": "object",
      "description": "Defines the nature of a vendor's business.",
      "properties": {
        "name": { "type": "string", "description": "The nature of business." },
        "code": { "type": "string", "description": "The unique code for the nature of business." }
      },
      "required": ["name", "code"]
    },
    "Vendor": {
      "title": "Vendor",
      "type": "object",
      "description": "Represents a vendor or supplier for the BillFlow module.",
      "properties": {
        "vendorId": { "type": "string" },
        "vendorName": { "type": "string" },
        "vendorShortName": { "type": "string" },
        "vendorType": { "type": "string", "enum": ["Individual", "Company"] },
        "vendorCategoryId": { "type": "string" },
        "vendorSubCategory": { "type": "string" },
        "natureOfBusinessId": { "type": "string" },
        "yearsOfExperience": { "type": "number" },
        "contactPersonName": { "type": "string" },
        "contactPersonDesignation": { "type": "string" },
        "mobileNumber": { "type": "string" },
        "alternateMobileNumber": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "officePhone": { "type": "string" },
        "whatsAppNumber": { "type": "string" },
        "officeAddress": { "type": "string" },
        "factoryAddress": { "type": "string" },
        "country": { "type": "string" },
        "city": { "type": "string" },
        "tradeLicenseNumber": { "type": "string" },
        "tradeLicenseExpiryDate": { "type": "string", "format": "date" },
        "tinNumber": { "type": "string" },
        "vatBinNumber": { "type": "string" },
        "nidOrCompanyRegNumber": { "type": "string" },
        "incorporationDate": { "type": "string", "format": "date" },
        "bankName": { "type": "string" },
        "branchName": { "type": "string" },
        "accountName": { "type": "string" },
        "accountNumber": { "type": "string" },
        "routingNumber": { "type": "string" },
        "paymentMethod": { "type": "string", "enum": ["Bank", "Cheque", "Mobile Banking"] },
        "mobileBankingProvider": { "type": "string" },
        "contractStartDate": { "type": "string", "format": "date" },
        "contractEndDate": { "type": "string", "format": "date" },
        "paymentTerms": { "type": "string" },
        "creditLimit": { "type": "number" },
        "currency": { "type": "string" },
        "taxDeductionApplicable": { "type": "boolean" },
        "vatApplicable": { "type": "boolean" },
        "suppliedItems": { "type": "array", "items": { "$ref": "#/entities/SuppliedItem" } },
        "documents": {
          "type": "object",
          "properties": {
            "tradeLicense": { "type": "string" },
            "bankChequeCopy": { "type": "string" },
            "contractAgreement": { "type": "string" },
            "vatCertificate": { "type": "string" },
            "complianceCertificates": { "type": "string" },
            "other": { "type": "string" }
          }
        },
        "loginId": { "type": "string" },
        "password": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdDate": { "type": "string", "format": "date-time" },
        "lastUpdatedBy": { "type": "string" },
        "vendorStatus": { "type": "string", "enum": ["Pending", "Active", "Suspended", "Blacklisted"] },
        "approvedBy": { "type": "string" },
        "approvalDate": { "type": "string", "format": "date" },
        "reviewFrequency": { "type": "string" },
        "riskLevel": { "type": "string", "enum": ["Low", "Medium", "High"] }
      },
      "required": ["vendorId", "vendorName", "vendorType", "vendorCategoryId", "email"]
    },
    "SuppliedItem": {
      "title": "Supplied Item/Service",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "unitOfMeasure": { "type": "string" },
        "rate": { "type": "number" },
        "minOrderQuantity": { "type": "number" },
        "leadTimeDays": { "type": "number" },
        "deliveryLocation": { "type": "string" },
        "deliveryFrequency": { "type": "string" }
      },
      "required": ["id", "name", "rate"]
    },
    "BillType": {
      "title": "Bill Type",
      "type": "object",
      "description": "Defines a type for a bill.",
      "properties": { "name": { "type": "string" }, "code": { "type": "string" } },
      "required": ["name", "code"]
    },
    "BillCategory": {
      "title": "Bill Category",
      "type": "object",
      "description": "Defines a category for a bill.",
      "properties": { "name": { "type": "string" }, "code": { "type": "string" } },
      "required": ["name", "code"]
    },
    "BillItem": {
      "title": "Bill Item",
      "type": "object",
      "description": "Represents a single line item in a bill.",
      "properties": {
        "name": { "type": "string" },
        "billItemCategoryId": { "type": "string" },
        "description": { "type": "string" },
        "unitOfMeasure": { "type": "string" },
        "quantity": { "type": "number" },
        "unitPrice": { "type": "number" },
        "grossAmount": { "type": "number" },
        "discountAmount": { "type": "number" },
        "netAmount": { "type": "number" }
      },
      "required": ["name", "quantity", "unitPrice", "grossAmount"]
    },
    "Bill": {
      "title": "Bill",
      "type": "object",
      "description": "Represents a single bill or invoice for payment processing.",
      "properties": {
        "billId": { "type": "string" },
        "billReferenceNumber": { "type": "string" },
        "vendorId": { "type": "string" },
        "billTypeId": { "type": "string" },
        "billCategoryId": { "type": "string" },
        "billSubCategory": { "type": "string" },
        "billDate": { "type": "string", "format": "date" },
        "billReceivedDate": { "type": "string", "format": "date" },
        "entryDate": { "type": "string", "format": "date-time" },
        "entryBy": { "type": "string" },
        "items": { "type": "array", "items": { "$ref": "#/entities/BillItem" } },
        "vatApplicable": { "type": "boolean" },
        "vatPercentage": { "type": "number" },
        "vatAmount": { "type": "number" },
        "tdsApplicable": { "type": "boolean" },
        "tdsPercentage": { "type": "number" },
        "tdsAmount": { "type": "number" },
        "otherCharges": { "type": "number" },
        "deductionAmount": { "type": "number" },
        "totalPayableAmount": { "type": "number" },
        "billingPeriodFrom": { "type": "string", "format": "date" },
        "billingPeriodTo": { "type": "string", "format": "date" },
        "poNumber": { "type": "string" },
        "woNumber": { "type": "string" },
        "grnNumber": { "type": "string" },
        "gatePassNumber": { "type": "string" },
        "invoiceNumber": { "type": "string" },
        "invoiceDate": { "type": "string", "format": "date" },
        "departmentCode": { "type": "string" },
        "departmentName": { "type": "string" },
        "costCenter": { "type": "string" },
        "project": { "type": "string" },
        "machineNumber": { "type": "string" },
        "budgetHead": { "type": "string" },
        "budgetRef": { "type": "string" },
        "documents": {
          "type": "object",
          "properties": {
            "vendorInvoice": { "type": "string" },
            "deliveryChallan": { "type": "string" },
            "workCompletionCert": { "type": "string" },
            "poCopy": { "type": "string" },
            "contractCopy": { "type": "string" },
            "supportingDocs": { "type": "string" },
            "remarksDoc": { "type": "string" }
          }
        },
        "approvalFlow": { "$ref": "#/entities/OrganizationSettings/properties/approvalFlow" },
        "approvalStatus": { "type": "number", "description": "0: Rejected, 1: Approved, 2: Pending" },
        "currentApproverId": { "type": "string", "description": "The ID of the employee currently assigned to approve this bill." },
        "approvalHistory": {
            "type": "array",
            "description": "An audit trail of the approval process.",
            "items": {
                "type": "object",
                "properties": {
                    "level": { "type": "number" },
                    "approverId": { "type": "string" },
                    "status": { "type": "string", "enum": ["Approved", "Rejected"] },
                    "timestamp": { "type": "string", "format": "date-time" },
                    "remarks": { "type": "string" }
                }
            }
        }
      },
      "required": ["billId", "vendorId", "billTypeId", "billDate", "totalPayableAmount"]
    },
    "BillItemCategory": {
      "title": "Bill Item Category",
      "type": "object",
      "description": "Defines a category for a billable item.",
      "properties": {
        "name": { "type": "string" },
        "code": { "type": "string" },
        "isSpecial": { "type": "boolean", "description": "Indicates if this is a special category of item." }
      },
      "required": ["name", "code"]
    },
    "BillItemMaster": {
      "title": "Bill Item Master",
      "type": "object",
      "description": "Master data for billable items and services.",
      "properties": {
        "name": { "type": "string" },
        "billItemCategoryId": { "type": "string" },
        "description": { "type": "string" },
        "unitOfMeasure": { "type": "string" },
        "unitPrice": { "type": "number" }
      },
      "required": ["name", "billItemCategoryId", "unitPrice"]
    },
    "ProcessCode": {
      "title": "Process Code",
      "type": "object",
      "description": "Defines a process code for demand notes.",
      "properties": {
        "name": { "type": "string" },
        "code": { "type": "string" }
      },
      "required": ["name", "code"]
    },
    "DemandType": {
      "title": "Demand Type",
      "type": "object",
      "description": "Defines a type for demand notes.",
      "properties": {
        "name": { "type": "string" },
        "code": { "type": "string" }
      },
      "required": ["name", "code"]
    },
    "DemandNoteItem": {
      "title": "Demand Note Item",
      "type": "object",
      "description": "Represents a single line item in a demand note.",
      "properties": {
        "billItemMasterId": { "type": "string", "description": "Reference to the master item from BillFlow." },
        "particulars": { "type": "string" },
        "requiredQty": { "type": "number" },
        "unit": { "type": "string" },
        "remarks": { "type": "string" },
        "brandName": { "type": "string" },
        "modelNo": { "type": "string" },
        "otherDetails": { "type": "string" }
      },
      "required": ["billItemMasterId", "requiredQty"]
    },
    "DemandNote": {
      "title": "Demand Note",
      "type": "object",
      "description": "Represents a requisition for items or services.",
      "properties": {
        "demandNoteNumber": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "departmentId": { "type": "string" },
        "sectionId": { "type": "string" },
        "processCodeId": { "type": "string" },
        "demandTypeId": { "type": "string" },
        "deliveryPlace": { "type": "string" },
        "contactPersonName": { "type": "string" },
        "contactPersonNumber": { "type": "string" },
        "budgetAmount": { "type": "number" },
        "budgetYearAndListNo": { "type": "string" },
        "purpose": { "type": "string" },
        "items": { "type": "array", "items": { "$ref": "#/entities/DemandNoteItem" } },
        "remarks": { "type": "string" },
        "createdBy": { "type": "string", "description": "Employee ID of the creator." },
        "entryDate": { "type": "string", "format": "date-time", "description": "Timestamp of when the demand note was created." },
        "approvalStatus": { "type": "number", "description": "0: Rejected, 1: Approved, 2: Pending" },
        "currentApproverId": { "type": "string" },
        "approvalFlow": {
            "type": "object",
            "description": "The determined approval workflow for this specific demand note.",
            "properties": {
                "steps": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "stepName": { "type": "string" },
                            "approverId": { "type": "string" }
                        }
                    }
                }
            }
        },
        "approvalHistory": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "level": { "type": "number" },
                    "approverId": { "type": "string" },
                    "status": { "type": "string", "enum": ["Approved", "Rejected"] },
                    "timestamp": { "type": "string", "format": "date-time" },
                    "remarks": { "type": "string" }
                }
            }
        },
        "gpConcernOfficerId": { "type": "string", "description": "Employee ID of the assigned GP Concern Officer." },
        "gpAssignedBy": { "type": "string", "description": "Employee ID of the GP Officer who assigned the note." },
        "gpAssignedDate": { "type": "string", "format": "date-time" },
        "vendorAssignmentDate": { "type": "string", "format": "date-time", "description": "The date and time when vendors were first assigned for quotation." },
        "gpStatus": { "type": "string", "enum": ["Pending", "Assigned"], "description": "The status of the General Purchase assignment." },
        "quotations": {
          "type": "array",
          "description": "A list of quotations received from vendors for this demand note.",
          "items": {
            "type": "object",
            "properties": {
              "vendorId": { "type": "string" },
              "fileName": { "type": "string" },
              "fileDataUrl": { "type": "string" }
            },
            "required": ["vendorId", "fileName", "fileDataUrl"]
          }
        }
      },
      "required": ["demandNoteNumber", "date", "departmentId", "purpose"]
    },
    "ComparativeStatement": {
      "title": "Comparative Statement",
      "description": "A comparative statement of quotations from multiple vendors for a demand note.",
      "type": "object",
      "properties": {
        "csNumber": { "type": "string", "description": "Unique identifier for the CS." },
        "csDate": { "type": "string", "format": "date", "description": "Date the CS was created." },
        "demandNoteId": { "type": "string", "description": "The ID of the related demand note." },
        "selectedVendorId": { "type": "string", "description": "The ID of the vendor selected for the purchase order." },
        "vendorSelectorId": { "type": "string", "description": "The ID of the employee responsible for selecting the vendor." },
        "vendorSelectionDate": { "type": "string", "format": "date-time", "description": "The date and time when the final vendor was selected." },
        "items": {
          "type": "array",
          "description": "The list of items being compared.",
          "items": {
            "type": "object",
            "properties": {
              "demandNoteItemId": { "type": "string" },
              "particulars": { "type": "string" },
              "unit": { "type": "string" },
              "quantity": { "type": "number" },
              "vendorQuotes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "vendorId": { "type": "string" },
                    "unitPrice": { "type": "number" }
                  },
                  "required": ["vendorId"]
                }
              }
            }
          }
        },
        "vendorDetails": {
          "type": "array",
          "description": "Details for each vendor in the comparison.",
          "items": {
            "type": "object",
            "properties": {
              "vendorId": { "type": "string" },
              "discountType": { "type": "string", "enum": ["Percentage", "Amount"] },
              "discountValue": { "type": "number" },
              "deliveryTerms": { "type": "string" },
              "vatPercentage": { "type": "number", "description": "VAT percentage for this vendor's quote." },
              "taxPercentage": { "type": "number", "description": "Tax percentage for this vendor's quote." },
              "paymentTerms": { "type": "string" },
              "warranty": { "type": "string" },
              "sampleConfirmed": { "type": "string", "enum": ["Yes", "No", "N/A"] }
            },
            "required": ["vendorId"]
          }
        },
        "createdBy": { "type": "string", "description": "Employee ID of the creator." },
        "approvalAmount": { "type": "number", "description": "The calculated amount used as the basis for the approval workflow." },
        "approvalAmountBasis": { "type": "string", "enum": ["Minimum", "Average", "Maximum"], "description": "The basis used to calculate the approval amount." },
        "approvalFlow": {
            "type": "object",
            "description": "The determined approval workflow for this specific CS.",
            "properties": {
                "steps": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "stepName": { "type": "string" },
                            "approverId": { "type": "string" }
                        }
                    }
                }
            }
        },
        "approvalStatus": { "type": "number", "description": "0: Rejected, 1: Approved, 2: Pending Vendor Selection, 3+: Pending Approval Steps" },
        "currentApproverId": { "type": "string" },
        "approvalHistory": {
            "type": "array",
            "description": "An audit trail of the approval process.",
            "items": {
                "type": "object",
                "properties": {
                    "level": { "type": "number" },
                    "approverId": { "type": "string" },
                    "status": { "type": "string", "enum": ["Approved", "Rejected"] },
                    "timestamp": { "type": "string", "format": "date-time" },
                    "remarks": { "type": "string" }
                }
            }
        }
      },
      "required": ["csNumber", "csDate", "demandNoteId"]
    },
    "PurchaseOrder": {
      "title": "Purchase Order",
      "description": "Represents a formal purchase order issued to a vendor.",
      "type": "object",
      "properties": {
        "poNumber": { "type": "string", "description": "Unique identifier for the Purchase Order." },
        "poDate": { "type": "string", "format": "date", "description": "Date the PO was issued." },
        "demandNoteId": { "type": "string", "description": "The ID of the originating demand note." },
        "csId": { "type": "string", "description": "The ID of the related comparative statement." },
        "vendorId": { "type": "string", "description": "The ID of the vendor to whom the PO is issued." },
        "items": {
          "type": "array",
          "description": "The list of items being ordered.",
          "items": {
            "type": "object",
            "properties": {
              "demandNoteItemId": { "type": "string" },
              "particulars": { "type": "string" },
              "unit": { "type": "string" },
              "quantity": { "type": "number" },
              "unitPrice": { "type": "number" },
              "totalPrice": { "type": "number" }
            },
            "required": ["demandNoteItemId", "particulars", "quantity", "unitPrice"]
          }
        },
        "totalAmount": { "type": "number", "description": "The grand total amount for the order." },
        "discountAmount": { "type": "number", "description": "Total discount amount applied." },
        "vatAmount": { "type": "number", "description": "Total VAT amount." },
        "taxAmount": { "type": "number", "description": "Total tax amount." },
        "netPayableAmount": { "type": "number", "description": "The final payable amount after all adjustments." },
        "deliveryTerms": { "type": "string" },
        "paymentTerms": { "type": "string" },
        "warranty": { "type": "string" },
        "expectedDeliveryDate": { "type": "string", "format": "date" },
        "status": { "type": "string", "enum": ["Pending", "Partially Delivered", "Completed", "Cancelled"] },
        "createdBy": { "type": "string", "description": "Employee ID of the creator." },
        "createdAt": { "type": "string", "format": "date-time" },
        "comments": { "type": "string", "description": "Additional comments on the PO." },
        "confirmedBySupplier": { "type": "boolean", "description": "Indicates if the supplier has confirmed the order." },
        "mandatoryTerms": { "type": "string", "description": "The mandatory terms and conditions for this PO." },
        "otherTerms": { "type": "string", "description": "Other terms and conditions for this PO." }
      },
      "required": ["poNumber", "poDate", "demandNoteId", "vendorId", "totalAmount"]
    },
    "MRR": {
      "title": "Material Receiving Report",
      "description": "Records the physical receipt of materials against a Purchase Order.",
      "type": "object",
      "properties": {
        "mrrNumber": { "type": "string" },
        "receivingDate": { "type": "string", "format": "date" },
        "departmentName": { "type": "string" },
        "sectionName": { "type": "string" },
        "supplierName": { "type": "string" },
        "supplierAddress": { "type": "string" },
        "issueDate": { "type": "string", "format": "date" },
        "shipmentType": { "type": "string" },
        "containerSize": { "type": "string" },
        "containerNo": { "type": "string" },
        "invoiceNumber": { "type": "string" },
        "demandNoteNumber": { "type": "string" },
        "challanNumber": { "type": "string" },
        "poId": { "type": "string" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "particulars": { "type": "string" },
              "description": { "type": "string" },
              "receivedQty": { "type": "number" },
              "unit": { "type": "string" },
              "unitPrice": { "type": "number" },
              "amount": { "type": "number" }
            }
          }
        },
        "totalAmount": { "type": "number" },
        "goodsCondition": { "type": "string", "enum": ["Ok", "Not Ok"] },
        "packageCondition": { "type": "string", "enum": ["Ok", "Not Ok"] },
        "remarks": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "receiverConfirmantId": { "type": "string" },
        "documents": {
          "type": "object",
          "properties": {
            "bill": { "type": "array", "items": { "type": "object", "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "file": { "type": "string" } } } },
            "challan": { "type": "array", "items": { "type": "object", "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "file": { "type": "string" } } } }
          }
        },
        "approvalStatus": { "type": "number" },
        "currentApproverId": { "type": "string" },
        "approvalFlow": {
            "type": "object",
            "properties": {
                "steps": { "type": "array", "items": { "type": "object", "properties": { "stepName": { "type": "string" }, "approverId": { "type": "string" } } } }
            }
        },
        "approvalHistory": { "type": "array", "items": { "type": "object" } }
      },
      "required": ["mrrNumber", "receivingDate", "poId", "supplierName"]
    },
    "PaymentNote": {
      "title": "Payment Note",
      "type": "object",
      "description": "An official payment request derived from an approved MRR.",
      "properties": {
        "pnNumber": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "mrrId": { "type": "string" },
        "amount": { "type": "number" },
        "amountInWords": { "type": "string" },
        "paymentType": { "type": "string", "enum": ["Credit", "LC", "Sales Contract", "Advance", "Rest"] },
        "paymentMode": { "type": "string", "enum": ["AC Payee", "TT", "Pay-Order", "FDD"] },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "approvalStatus": { "type": "number" },
        "currentApproverId": { "type": "string" },
        "approvalHistory": { "type": "array", "items": { "type": "object" } }
      },
      "required": ["pnNumber", "date", "amount", "paymentType", "paymentMode"]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "/settings/organization": { "schema": { "$ref": "#/entities/OrganizationSettings" }, "description": "Stores the single, global configuration for the organization." },
    "/users/{userId}/acknowledgedTasks/{taskId}": { "schema": { "$ref": "#/entities/AcknowledgedTask" }, "description": "Stores user-specific acknowledgments for tasks." },
    "/departments/{departmentId}": { "schema": { "$ref": "#/entities/Department" }, "description": "Stores organizational departments." },
    "/sections/{sectionId}": { "schema": { "$ref": "#/entities/Section" }, "description": "Stores organization sections or departments." },
    "/designations/{designationId}": { "schema": { "$ref": "#/entities/Designation" }, "description": "Stores job titles and designations." },
    "/employees/{employeeId}": { "schema": { "$ref": "#/entities/Employee" }, "description": "Stores employee profiles." },
    "/vehicleTypes/{vehicleTypeId}": { "schema": { "$ref": "#/entities/VehicleType" }, "description": "Stores vehicle categories." },
    "/vehicleBrands/{vehicleBrandId}": { "schema": { "$ref": "#/entities/VehicleBrand" }, "description": "Stores vehicle brands." },
    "/locations/{locationId}": { "schema": { "$ref": "#/entities/Location" }, "description": "Stores geographic locations." },
    "/deliveryPlaces/{deliveryPlaceId}": { "schema": { "$ref": "#/entities/DeliveryPlace" }, "description": "Stores office locations for procurement delivery." },
    "/routes/{routeId}": { "schema": { "$ref": "#/entities/Route" }, "description": "Stores routes between locations." },
    "/tripPurposes/{tripPurposeId}": { "schema": { "$ref": "#/entities/TripPurpose" }, "description": "Stores purposes for vehicle trips." },
    "/expenseTypes/{expenseTypeId}": { "schema": { "$ref": "#/entities/ExpenseType" }, "description": "Stores types of expenses." },
    "/maintenanceTypes/{maintenanceTypeId}": { "schema": { "$ref": "#/entities/MaintenanceType" }, "description": "Stores types of maintenance." },
    "/maintenanceExpenseTypes/{maintenanceExpenseTypeId}": { "schema": { "$ref": "#/entities/MaintenanceExpenseType" }, "description": "Stores types of expenses for maintenance." },
    "/parts/{partId}": { "schema": { "$ref": "#/entities/Part" }, "description": "Stores vehicle parts." },
    "/serviceCenters/{serviceCenterId}": { "schema": { "$ref": "#/entities/ServiceCenter" }, "description": "Stores service centers or garages." },
    "/accidentTypes/{accidentTypeId}": { "schema": { "$ref": "#/entities/AccidentType" }, "description": "Stores types of accidents." },
    "/severityLevels/{severityLevelId}": { "schema": { "$ref": "#/entities/SeverityLevel" }, "description": "Stores severity levels for accidents." },
    "/faultStatuses/{faultStatusId}": { "schema": { "$ref": "#/entities/FaultStatus" }, "description": "Stores fault statuses of accidents." },
    "/vendorCategories/{vendorCategoryId}": { "schema": { "$ref": "#/entities/VendorCategory" }, "description": "Stores vendor categories for the BillFlow module." },
    "/vendorNatureOfBusiness/{vendorNatureOfBusinessId}": { "schema": { "$ref": "#/entities/VendorNatureOfBusiness" }, "description": "Stores the nature of business for vendors." },
    "/vendors/{vendorId}": { "schema": { "$ref": "#/entities/Vendor" }, "description": "Stores vendor profiles for the BillFlow module." },
    "/billTypes/{billTypeId}": { "schema": { "$ref": "#/entities/BillType" }, "description": "Stores master list of bill types." },
    "/billCategories/{billCategoryId}": { "schema": { "$ref": "#/entities/BillCategory" }, "description": "Stores master list of bill categories." },
    "/bills/{billId}": { "schema": { "$ref": "#/entities/Bill" }, "description": "Stores all submitted bills." },
    "/billItemCategories/{billItemCategoryId}": { "schema": { "$ref": "#/entities/BillItemCategory" }, "description": "Stores categories for billable items." },
    "/billItemMasters/{billItemMasterId}": { "schema": { "$ref": "#/entities/BillItemMaster" }, "description": "Stores the master list of billable items and services." },
    "/demandNotes/{demandNoteId}": { "schema": { "$ref": "#/entities/DemandNote" }, "description": "Stores all created demand notes." },
    "/processCodes/{processCodeId}": { "schema": { "$ref": "#/entities/ProcessCode" }, "description": "Stores master data for process codes." },
    "/demandTypes/{demandTypeId}": { "schema": { "$ref": "#/entities/DemandType" }, "description": "Stores master data for demand types." },
    "/comparativeStatements/{csId}": { "schema": { "$ref": "#/entities/ComparativeStatement" }, "description": "Stores all generated comparative statements." },
    "/purchaseOrders/{poId}": { "schema": { "$ref": "#/entities/PurchaseOrder" }, "description": "Stores all created purchase orders." },
    "/mrrs/{mrrId}": { "schema": { "$ref": "#/entities/MRR" }, "description": "Stores all Material Receiving Reports." },
    "/paymentNotes/{pnId}": { "schema": { "$ref": "#/entities/PaymentNote" }, "description": "Stores all payment notes for finance processing." }
  }
}
